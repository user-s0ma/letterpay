{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letterpay",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 公開先のドメインを決めるまでは workers.dev で動かす
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "VITE_PUBLIC_APP_URL": "https://letterpay.example.workers.dev",
    // Cloudflare Turnstile のサイトキー (下は常に通るテスト用の値。公開前に本物に替える)
    "VITE_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AUTH_EMAIL_FROM": "noreply@example.com",
    "LETTER_EMAIL_FROM": "letters@example.com",
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    // 審査員向けのデモアカウントの店が代金を受け取るアカウントと、払う側のアカウント (どちらも PayPal のサンドボックス)。
    // 払う側のパスワードはデモの画面に出すが、値は wrangler secret put DEMO_SANDBOX_BUYER_PASSWORD で入れる
    "DEMO_PAYEE_EMAIL": "sb-po432153561359@business.example.com",
    "DEMO_SANDBOX_BUYER_EMAIL": "sb-xualy53547202@personal.example.com"
  },
  // `npx wrangler d1 create letterpay` で作った DB (APAC)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "letterpay",
      "database_id": "02d4d5c3-af8d-40c6-b44d-e97d2e4100dc",
      "migrations_dir": "drizzle"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client"
  },
  // 毎日 0:00 UTC (日本時間 9:00) に、送る日になった客へメールを送る
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
