{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letterpay",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 公開先のドメインを決めるまでは workers.dev で動かす
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "VITE_PUBLIC_APP_URL": "https://letterpay.example.workers.dev",
    // Cloudflare Turnstile のサイトキー (下は常に通るテスト用の値。公開前に本物に替える)
    "VITE_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AUTH_EMAIL_FROM": "noreply@example.com",
    "LETTER_EMAIL_FROM": "letters@example.com",
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client"
  },
  // 毎日 0:00 UTC (日本時間 9:00) に、送る日になった客へメールを送る
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
