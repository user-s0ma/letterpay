{
  "name": "letterpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5180 --strictPort",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src/ tests/",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply letterpay --remote",
    "type-check": "react-router typegen && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply letterpay --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@marsidev/react-turnstile": "^1.5.3",
    "@tanstack/react-query": "^5.101.2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "better-auth": "1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "i18next": "^26.3.4",
    "isbot": "^5.1.44",
    "lucide-react": "^1.23.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "wrangler": "^4.149.0"
  }
}
