# 手元で動かすときの秘密の値。.dev.vars に写して埋める (git に入らない)。
# 本番は `wrangler secret put <名前>` で入れる

# --- Database (TiDB Serverless)
DATABASE_URL=mysql://user:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/letterpay?sslaccept=strict

# --- Auth (better-auth: email/password + Google)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# Leave empty to disable the captcha in local development (http:// only)
TURNSTILE_SECRET_KEY=

# --- PayPal (REST app from developer.paypal.com, sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Claude
ANTHROPIC_API_KEY=

# --- Signs the links in recommendation emails (32+ random characters)
LINK_SIGNING_SECRET=replace-with-at-least-32-random-characters
