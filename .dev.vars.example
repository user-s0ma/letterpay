# 手元で動かすときの秘密の値。.dev.vars に写して埋める (git に入らない)。
# 本番は `wrangler secret put <名前>` で入れる

# 手元ではメールのリンクを localhost に向ける (wrangler.jsonc の vars より優先される)
VITE_PUBLIC_APP_URL=http://localhost:5180

# --- Auth (better-auth: email/password)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Leave empty to disable the captcha in local development (http:// only)
TURNSTILE_SECRET_KEY=

# --- PayPal (REST app from developer.paypal.com, sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Claude
ANTHROPIC_API_KEY=

# --- Signs the links in recommendation emails (32+ random characters)
LINK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# --- Demo account for hackathon judges (PayPal sandbox). The buyer password is shown on the demo screen
DEMO_PAYEE_EMAIL=
DEMO_SANDBOX_BUYER_EMAIL=
DEMO_SANDBOX_BUYER_PASSWORD=
